// Copy this to secrets.h (gitignored) and fill in real values.
// Never commit secrets.h.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// tama-server's LAN address. Find it with: ipconfig getifaddr en0
#define TAMA_SERVER_HOST "192.168.1.11"
#define TAMA_SERVER_PORT 8080

// Minted with: curl -X POST http://<host>:8080/tokens -H "Authorization: Bearer <adminToken>" \
//   -H 'content-type: application/json' -d '{"deviceName":"cheeko-01"}'
// Or re-pair later with a short-lived code via POST /pair, same flow the phone used.
#define TAMA_DEVICE_TOKEN "paste-the-device-token-here"
